global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend entrada_web
    bind *:80
    acl ruta_usuarios   path_beg /api/users
    acl ruta_productos  path_beg /api/products
    acl ruta_ordenes    path_beg /api/orders
    use_backend grupo_usuarios  if ruta_usuarios
    use_backend grupo_productos if ruta_productos
    use_backend grupo_ordenes   if ruta_ordenes

backend grupo_usuarios
    balance roundrobin
    option httpchk GET /health
    http-response set-header X-Served-By %s
    server usuarios_3001 10.0.1.11:3001 check
    server usuarios_3011 10.0.1.11:3011 check

backend grupo_productos
    balance roundrobin
    option httpchk GET /health
    http-response set-header X-Served-By %s
    server productos_3002 10.0.1.11:3002 check
    server productos_3012 10.0.1.11:3012 check

backend grupo_ordenes
    balance roundrobin
    option httpchk GET /health
    http-response set-header X-Served-By %s
    server ordenes_3003 10.0.1.11:3003 check
    server ordenes_3013 10.0.1.11:3013 check

listen panel_estadisticas
    bind *:8080
    stats enable
    stats uri /stats
    stats refresh 5s
    stats auth admin:{{ stats_password }}
